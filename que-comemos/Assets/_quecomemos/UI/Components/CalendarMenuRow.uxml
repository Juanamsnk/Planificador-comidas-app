<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="../Styles/Molecules.uss" />
    <ui:VisualElement name="calendar-menu-row" class="calendar-menu-row">
        <ui:Button name="calendar-name-btn" text="Calendario compartido" class="menu-item" />
        <ui:Button name="pin-btn" text="" class="pin-menu-btn" tooltip="Fijar calendario" />
        <ui:Button name="leave-btn" text="&#10005;" class="leave-menu-btn" tooltip="Quitar calendario" />
    </ui:VisualElement>
</ui:UXML>