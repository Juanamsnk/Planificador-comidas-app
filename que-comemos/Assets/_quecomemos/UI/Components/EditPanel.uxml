<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="ReminderLine" src="project://database/Assets/_quecomemos/UI/Components/ReminderLine.uxml?fileID=9197481963319205126&amp;guid=7fbb8088122dc614e94af36ad3a57440&amp;type=3#ReminderLine"/>
    <Style src="project://database/Assets/_quecomemos/UI/Styles/Atoms.uss?fileID=7433441132597879392&amp;guid=87ec63ee3523e6b4eb52966548b59a7c&amp;type=3#Atoms"/>
    <Style src="project://database/Assets/_quecomemos/UI/Styles/Organisms.uss?fileID=7433441132597879392&amp;guid=4606e07a7bdf1eb48825e5e55ef1577d&amp;type=3#Organisms"/>
    <ui:VisualElement name="edit-panel" class="edit-panel" style="display: none;">
        <ui:Label name="edit-panel-title" text="Comida · Lunes 1 de septiembre" class="edit-panel__title"/>
        <ui:VisualElement class="edit-panel__row">
            <ui:VisualElement class="edit-panel__field">
                <ui:Label text="@edit.dish" class="field-label"/>
                <ui:TextField name="dish-field" placeholder-text="@edit.dishPlaceholder" class="input-field"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="edit-panel__btn-row" style="margin-bottom: 14px;">
            <ui:Button name="random-dish-btn" text="@edit.random" icon-image="" class="btn btn--ghost"/>
            <ui:Button name="old-dish-btn" text="@edit.forgotten" icon-image="" class="btn btn--ghost"/>
        </ui:VisualElement>
        <ui:Instance template="ReminderLine" name="reminder-line-instance"/>
        <ui:VisualElement class="edit-panel__row">
            <ui:VisualElement class="edit-panel__field">
                <ui:Label text="@edit.reminderName" class="field-label"/>
                <ui:TextField name="reminder-title-field" placeholder-text="@edit.reminderPlaceholder" class="input-field"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="edit-panel__btn-row">
            <ui:Button name="save-btn" text="@edit.save" focusable="false" class="btn btn--primary"/>
            <ui:Button name="delete-btn" text="@edit.delete" focusable="false" class="btn btn--danger" style="display: none;"/>
            <ui:Button name="close-btn" text="@edit.close" focusable="false" class="btn btn--ghost"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
