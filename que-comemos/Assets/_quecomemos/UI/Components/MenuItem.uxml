<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="../Styles/Molecules.uss" />

    <!--
      Molécula: ítem de fila del menú hamburguesa (equivalente a .menu-item).
      Variantes: añade la clase "menu-itemactive" o "menu-itemdanger"
      desde C# según corresponda (calendario activo / cerrar sesión).
    -->
    <ui:Button name="menu-item" text="Mi calendario" class="menu-item" />
</ui:UXML>
