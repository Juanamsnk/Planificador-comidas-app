/* ==========================================================================
   ATOMS.uss — piezas mínimas reutilizables (botones, inputs, texto, badges)
   Equivalente a: .brand h1, .menu-btn, .nav-btn, .today-btn, .btn(+variants),
   input[type=...], label, .calendar-owner-badge, .demo-badge, .guest-note
   ========================================================================== */

/* ---------- Tipografía base ---------- */
/* Sin fuentes propias importadas todavía: se usa la fuente por defecto de
   Unity (la que trae el USS por defecto del proyecto). Cuando importes
   "Newsreader" y "Manrope" como Font Asset, añade aquí la línea:
     -unity-font-definition: url("project://database/Assets/.../TuFuente SDF.asset");
   dentro de .text-body (Manrope) y .text-heading / .brand-title (Newsreader). */
.text-body {
    font-size: 14px;
    color: var(--paper);
}

.text-heading {
    -unity-font-style: italic;
    color: var(--paper);
    -unity-text-align: middle-left;
}

.brand-title {
    font-size: 30px;
    color: var(--paper);
    -unity-font-style: italic;
    letter-spacing: -0.3px;
}

/* ---------- Botones circular/cuadrados de icono (menú, tema) ---------- */
.icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line-strong);
    color: var(--paper);
    font-size: 17px;
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;

    background-size: 20px 20px;
    background-position: center;
    background-repeat: no-repeat;
}

.icon-btn:hover {
    background-color: var(--surface-hover);
}

/* ---------- Botones de navegación de semana ---------- */
.nav-btn {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line-strong);
    color: var(--paper);
    font-size: 16px;
    -unity-text-align: middle-center;
}

.nav-btn:hover {
    background-color: var(--surface-hover);
}

.today-btn {
    font-size: 12px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 10px;
    padding-left: 8px;
    padding-right: 8px;
    height: 34px;
    color: var(--paper);
    -unity-text-align: middle-center;
}

.today-btn:hover {
    background-color: var(--surface-hover);
}

/* ---------- Botones genéricos (.btn / .btn.primary / .btn.ghost / .btn.danger) ---------- */
.btn {
    font-size: 13px;
    -unity-font-style: bold;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 13px;
    padding-right: 13px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--line-strong);
    background-color: var(--surface-2);
    color: var(--paper);
    -unity-text-align: middle-center;
    margin-right: 8px;
    margin-bottom: 8px;
}

.btn:hover {
    background-color: var(--surface-hover);
}

.btn--primary {
    background-color: var(--herb);
    color: var(--herb-ink);
    border-color: var(--herb);
}

.btn--primary:hover {
    background-color: var(--herb-deep);
}

.btn--danger {
    color: var(--rust);
    border-color: var(--rust);
}

.btn--danger:hover {
    background-color: rgba(226, 115, 90, 0.15);
}

.btn--ghost {
    background-color: rgba(0, 0, 0, 0);
}

/* ---------- Campos de texto (input[type=text/password/date/time]) ---------- */
.input-field {
    font-size: 15px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 10px;
    background-color: var(--ink);
    color: var(--paper);
}

.input-field--compact {
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 9px;
    padding-right: 9px;
    font-size: 13px;
}

/* Unity dibuja el recuadro de texto de un TextField con un elemento
   INTERNO propio (nombre "unity-text-input"), que trae su propio fondo
   blanco del tema base y no hereda las reglas de arriba (esas solo
   afectan al contenedor exterior). Sin esto se ve un recuadro blanco sin
   estilo aunque .input-field esté bien puesto. Cubrimos los dos nombres
   de clase por si cambian entre versiones de Unity. */
.input-field > .unity-text-field__input,
.input-field > .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    color: var(--paper);
    /* font-size no hace falta repetirlo aquí: en USS es una propiedad
       "heredada", así que ya toma el valor de .input-field (15px o 13px
       si es --compact) automáticamente. La palabra "inherit" no es una
       sintaxis válida en USS (a diferencia de CSS). */
}

/* El propio TextField (BaseField) suele traer márgenes por defecto del
   tema base; los quitamos para que el spacing lo controle solo nuestro
   layout (edit-panel__row, edit-panel__field, reminder-line...). */
.input-field {
    margin: 0;
}

/* ---------- Etiqueta de campo ---------- */
.field-label {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 6px;
}

/* ---------- Punto de color para "Comida" / "Cena" ---------- */
.meal-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    margin-right: 5px;
}

.meal-dot--comida {
    background-color: var(--gold);
}

.meal-dot--cena {
    background-color: var(--plum);
}

/* ---------- Badges (owner / demo / guest) ---------- */
.badge {
    font-size: 12px;
    -unity-font-style: bold;
    border-radius: 100px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 13px;
    padding-right: 13px;
    -unity-text-align: middle-left;
    /* Sin esto, al ser hijo de un contenedor en columna (.topbar), se
       estira para ocupar todo el ancho disponible en vez de ajustarse a
       su propio texto — el mismo tipo de fallo que ya hemos visto con
       .day-card, el menú, etc. */
    align-self: flex-start;
}

.badge--owner {
    color: var(--herb);
    background-color: rgba(143, 196, 110, 0.12);
    border-width: 1px;
    border-color: rgba(143, 196, 110, 0.35);
    border-bottom-left-radius : 6px;
    border-top-left-radius : 6px;
    border-bottom-right-radius : 6px;
    border-top-right-radius : 6px;
}

.badge--shared {
    color: var(--plum);
    background-color: rgba(124, 147, 196, 0.14);
    border-width: 1px;
    border-color: rgba(124, 147, 196, 0.4);
    border-bottom-left-radius : 6px;
    border-top-left-radius : 6px;
    border-bottom-right-radius : 6px;
    border-top-right-radius : 6px;
}

.badge--demo {
    color: var(--gold);
    background-color: rgba(232, 178, 77, 0.14);
    border-width: 1px;
    border-color: rgba(232, 178, 77, 0.4);
}

.guest-note {
    font-size: 12px;
    color: var(--muted);
}
/* ---------- Toggle/Checkbox para recordatorios ---------- */
.unity-toggle {
    flex-direction: row;
    align-items: center;
}

.unity-toggle__input {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-right: 10px;
    border-width: 2px;
    border-color: var(--line-strong);
    border-radius: 4px;
    background-color: var(--ink);
}

.unity-toggle__input:hover {
    border-color: var(--herb);
}

.unity-toggle__input:checked {
    background-color: var(--herb);
    border-color: var(--herb);
}

.unity-toggle__input:checked #unity-checkmark {
    color: var(--herb-ink);
    -unity-font-style: bold;
    background-color: var(--herb);
}

#unity-checkmark {
    width: 100%;
    height: 100%;
    font-size: 16px;
    -unity-text-align: middle-center;
}

.unity-toggle__label {
    font-size: 13px;
    color: var(--muted);
    flex-shrink: 1;
}
