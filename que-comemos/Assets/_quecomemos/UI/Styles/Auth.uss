.auth-container {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 40px 24px;
    background-color: var(--ink);
}

.auth-header {
    flex-direction: column;
    align-items: center;
    margin-bottom: 60px;
    text-align: center;
}

.logo-wrapper {
    width: 120px;
    height: 120px;
    border-radius: 30px;
    background: linear-gradient(135deg, var(--herb), var(--herb-hover));
    justify-content: center;
    align-items: center;
    margin-bottom: 24px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    flex-shrink: 0;
}

.app-logo {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/_quecomemos/Sprites/Icon-app/que_comemos_app_icon_v2.png?fileID=2800000&guid=b77c0b6033d15c943b85eb87aad3332f&type=3#que_comemos_app_icon_v2");
}

.app-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--paper);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.app-subtitle {
    font-size: 14px;
    color: var(--muted);
    max-width: 250px;
    -unity-text-align: middle-center;
}

.auth-actions {
    width: 100%;
    max-width: 300px;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 20px;
}

.auth-status {
    font-size: 12px;
    color: var(--muted);
    text-align: center;
    min-height: 16px;
    -unity-text-align: middle-center;
}
.guest-link-btn {
    width: auto;
    height: auto;
    padding: 4px 8px 6px 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--muted);
    color: var(--muted);
    font-size: 14px;
    -unity-text-align: middle-center;
    cursor: link;
    margin-top: 12px;
    white-space: nowrap;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: center;
}

.guest-link-btn:hover {
    border-bottom-color: var(--paper);
    color: var(--paper);
}

.theme-light .guest-link-btn {
    color: #666666;
    border-bottom-color: #666666;
}

.theme-light .guest-link-btn:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
}

.app-version { position: absolute; bottom: 20px; left: 0; right: 0; -unity-text-align: middle-center; font-size: 12px; opacity: 0.6; color : #FFFFFF;}
