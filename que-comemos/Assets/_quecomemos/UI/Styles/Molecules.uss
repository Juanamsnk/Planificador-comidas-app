/* ==========================================================================
   MOLECULES.uss — combinación de átomos con sentido propio
   Equivalente a: .day-card-head, .meal-tag, .cell-btn(+selected/empty),
   .menu-item(+active/danger), .leave-menu-btn, .calendar-menu-row,
   .reminder-line, .menu-section-label, .menu-divider
   ========================================================================== */

/* ---------- Cabecera de una tarjeta de día ----------
   Layout lateral (fecha a la izquierda, comidas a la derecha): es el
   único layout de esta app, pensada solo para móvil en portrait. */
.day-card-head {
    -unity-text-align: middle-left;
    justify-content: center;
    flex-direction: column;
    width: 72px;
    flex-shrink: 0;
    flex-grow: 0;
    border-right-width: 1px;
    border-right-color: var(--line);
    padding-right: 10px;
    margin-right: 12px;
}

.day-name {
    font-size: 11px;
    letter-spacing: 0.4px;
    color: var(--muted);
}

.day-num {
    font-size: 18px;
    color: var(--paper);
    -unity-font-style: italic;
    margin-top: 1px;
}

/* modificador cuando la tarjeta es "hoy" */
.day-card-head--today .day-name {
    color: var(--herb);
}

/* ---------- Slot de comida/cena (etiqueta + celda) ---------- */
.meal-slot {
    flex-direction: column;
    margin-bottom: 10px;
    flex-shrink: 0;
    flex-grow: 0;
}

.meal-tag {
    flex-direction: row;
    align-items: center;
    font-size: 10px;
    letter-spacing: 0.4px;
    -unity-font-style: bold;
    color: var(--muted);
    margin-bottom: 5px;
}

/* ---------- Celda de plato (botón) ---------- */
.cell-btn {
    width: 100%;
    min-height: 54px;
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 10px;
    background-color: var(--surface-2);
    padding: 8px 9px;
    color: var(--paper);
    -unity-text-align: middle-left;
    flex-direction: column;
    justify-content: center;
    white-space: normal;
    /* Misma razón que en .day-card: fija el alto solo a su contenido. */
    flex-shrink: 0;
    flex-grow: 0;
}

.cell-btn:hover {
    background-color: var(--surface-hover);
    border-color: var(--herb);
}

.cell-btn--selected {
    border-width: 1px;
    border-color: var(--herb);
    /* Antes usaba un verde con alpha (rgba con transparencia); en algunas
       versiones de UI Toolkit ese canal alfa no se mezcla como se espera
       y el fondo sale sólido/muy saturado. Usamos un color de superficie
       sólido en su lugar; el borde verde ya marca la selección. */
    background-color: var(--surface-hover);
}

.cell-dish {
    font-size: 13px;
    white-space: normal;
}

.cell-empty {
    font-size: 12px;
    color: var(--muted);
}

.cell-meta {
    font-size: 10px;
    color: var(--muted);
}

/* ---------- Ítem de menú desplegable ---------- */
.menu-section-label {
    font-size: 11px;
    letter-spacing: 0.4px;
    color: var(--muted);
    padding: 6px 10px 4px;
    flex-shrink: 0;
}

.menu-item {
    width: 100%;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    padding: 10px 11px;
    border-radius: 9px;
    /* El Button de Unity trae su propio borde del tema base; sin ponerlo
       a 0 se ve un contorno permanente que no está en la web (ahí un
       ítem de menú normal no tiene borde hasta que está activo/hover). */
    border-width: 0;
    font-size: 14px;
    color: var(--paper);
    flex-shrink: 0;
}

.menu-item:hover {
    background-color: var(--surface-hover);
}

.menu-item--active {
    background-color: rgba(143, 196, 110, 0.16);
    color: var(--herb);
    -unity-font-style: bold;
}

.menu-item--danger {
    color: var(--rust);
}

.menu-item--danger:hover {
    background-color: rgba(226, 115, 90, 0.15);
}

#shared-calendars-container {
    flex-shrink: 0;
}

.calendar-menu-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.calendar-menu-row .menu-item {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;                  /* CAMBIO: de 100% a auto */
    overflow: hidden;             /* NUEVO */
    text-overflow: ellipsis;      /* NUEVO: pone "..." si el texto es muy largo */
    white-space: nowrap;          /* NUEVO: una sola línea */
    margin-right: 8px;            /* NUEVO: separación de la X */
}

.leave-menu-btn {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--rust);
    font-size: 16px;
    -unity-text-align: middle-center;
    margin-left: 4px;
    flex-shrink: 0;
    margin-right: 12px;
}

.leave-menu-btn:hover {
    background-color: rgba(226, 115, 90, 0.15);
}

.menu-divider {
    height: 1px;
    background-color: var(--line-strong);
    margin: 7px 4px;
    flex-shrink: 0;
}

/* ---------- Línea de recordatorio (checkbox + fecha + hora) ---------- */
.reminder-line {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 16px;
}

.reminder-line > * {
    margin-right: 8px;
    margin-bottom: 4px;
}
