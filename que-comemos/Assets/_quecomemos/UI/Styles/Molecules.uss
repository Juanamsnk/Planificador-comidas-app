.day-card-head {
    -unity-text-align: middle-left;
    justify-content: center;
    flex-direction: column;
    width: 72px;
    flex-shrink: 0;
    flex-grow: 0;
    border-right-width: 1px;
    border-right-color: var(--line);
    padding-right: 10px;
    margin-right: 12px;
}

.day-name {
    font-size: 11px;
    letter-spacing: 0.4px;
    color: var(--muted);
}

.day-num {
    font-size: 18px;
    color: var(--paper);
    -unity-font-style: italic;
    margin-top: 1px;
}

.day-card-head--today .day-name {
    color: var(--herb);
}

.meal-slot {
    flex-direction: column;
    margin-bottom: 10px;
    flex-shrink: 0;
    flex-grow: 0;
}

.meal-tag {
    flex-direction: row;
    align-items: center;
    font-size: 10px;
    letter-spacing: 0.4px;
    -unity-font-style: bold;
    color: var(--muted);
    margin-bottom: 5px;
}

.cell-btn {
    width: 100%;
    min-height: 54px;
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 10px;
    background-color: var(--surface-2);
    padding: 8px 9px;
    color: var(--paper);
    -unity-text-align: middle-left;
    flex-direction: column;
    justify-content: center;
    white-space: normal;
    flex-shrink: 0;
    flex-grow: 0;
}

.cell-btn:hover {
    background-color: var(--surface-hover);
    border-color: var(--herb);
}

.cell-btn--selected {
    border-width: 1px;
    border-color: var(--herb);
    background-color: var(--surface-hover);
}

.cell-dish {
    font-size: 13px;
    white-space: normal;
}

.cell-empty {
    font-size: 12px;
    color: var(--muted);
}

.cell-meta {
    font-size: 10px;
    color: var(--muted);
}

.menu-section-label {
    font-size: 11px;
    letter-spacing: 0.4px;
    color: var(--muted);
    padding: 6px 10px 4px;
    flex-shrink: 0;
}

.menu-item {
    width: 100%;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    padding: 10px 11px;
    border-radius: 9px;
    border-width: 0;
    font-size: 14px;
    color: var(--paper);
    flex-shrink: 0;
}

.menu-item:hover {
    background-color: var(--surface-hover);
}

.menu-item--active {
    background-color: rgba(143, 196, 110, 0.16);
    color: var(--herb);
    -unity-font-style: bold;
}

.menu-item--danger {
    color: var(--rust);
}

.menu-item--danger:hover {
    background-color: rgba(226, 115, 90, 0.15);
}

#shared-calendars-container {
    flex-shrink: 0;
}

.calendar-menu-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.calendar-menu-row .menu-item {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;                  
    overflow: hidden;             
    text-overflow: ellipsis;      
    white-space: nowrap;          
    margin-right: 8px;     
}

.leave-menu-btn {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--rust);
    font-size: 16px;
    -unity-text-align: middle-center;
    margin-left: 4px;
    flex-shrink: 0;
    margin-right: 12px;
}

.leave-menu-btn:hover {
    background-color: rgba(226, 115, 90, 0.15);
}

.menu-divider {
    height: 1px;
    background-color: var(--line-strong);
    margin: 7px 4px;
    flex-shrink: 0;
}
.reminder-line {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 16px;
}

.reminder-line > * {
    margin-right: 8px;
    margin-bottom: 4px;
}

.pin-menu-btn {
    width: 28px;
    height: 28px;
    margin-right: 4px;
    background-color: transparent;
    border-width: 0;
    background-size: 18px 18px;
    background-repeat: no-repeat;
    background-position: center;
}

.footer {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 64px;  /* Aumentar de 56px a 80px (o más si quieres) */
    background-color: var(--surface);
    border-top-width: 1px;
    border-top-color: var(--line);
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    padding: 0;
    z-index: 100;
}

.footer-btn {
    flex-grow: 1;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 8px 0;
    border-top-width: 2px;
    border-top-color: transparent;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;  /* Aumentar de 4px a 6px */
}

.footer-btn:hover {
}

.footer-btn--active {
    border-top-color: var(--herb);
}

.footer-btn-icon {
    width: 32px;  /* Aumentar de 24px a 32px */
    height: 32px;  /* Aumentar de 24px a 32px */
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--muted);
}

.footer-btn--active .footer-btn-icon {
    -unity-background-image-tint-color: var(--herb);
}

.footer-btn-label {
    font-size: 12px;  /* Aumentar de 10px a 12px */
    -unity-text-align: middle-center;
    color: var(--muted);
}

.footer-btn--active .footer-btn-label {
    color: var(--herb);
}

.theme-light .footer {
    background-color: var(--surface);
}

.theme-light .footer-btn-icon {
    -unity-background-image-tint-color: #6B7267;
}

.theme-light .footer-btn--active .footer-btn-icon {
    -unity-background-image-tint-color: #5FA23B;
}

.theme-light .footer-btn-label {
    color: #999999;
}

.theme-light .footer-btn--active .footer-btn-label {
    color: var(--herb);
}

/* ==========================================================================
   NAV PANEL — panel de ajustes fullscreen
   ========================================================================== */

.nav-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 64px; /* el script lo ajusta con el inset inferior */
    background-color: var(--surface);
    flex-direction: column;
    z-index: 500;
}

.nav-settings-scroll {
    flex-grow: 1;
    padding: 0;
    margin: 0;
}

/* SETTINGS */
.settings-container {
    flex-direction: column;
    gap: 24px;
    padding: 16px;
}

.settings-section {
    flex-direction: column;
    gap: 16px;
}

.settings-section-title {
    font-size: 11px;
    letter-spacing: 0.4px;
    color: var(--muted);
    -unity-font-style: bold;
    padding-bottom: 12px;  /* Aumentar de 4px a 12px */
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
    margin-bottom: 8px;  /* Agregar margen abajo */
}

.settings-btn {
    width: 100%;
    min-height: 44px;
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 8px;
    color: var(--paper);
    font-size: 13px;
    -unity-text-align: middle-center;
    padding: 10px;
    margin-bottom: 8px;
    cursor: pointer;
}

.settings-btn:hover {
    background-color: var(--surface-hover);
    border-color: var(--herb);
    color: var(--herb);
}

.settings-btn--danger {
    color: #ff6b6b;
    border-color: #ff6b6b;
}

.settings-btn--danger:hover {
    background-color: rgba(255, 107, 107, 0.1);
    color: #ff8888;
    border-color: #ff8888;
}

/* TEMA CLARO */
.theme-light .nav-panel {
    background-color: var(--surface);
}

.theme-light .settings-section-title {
    color: var(--paper);
    border-bottom-color: var(--line);
}

.theme-light .settings-btn {
    background-color: var(--surface-2);
    color: var(--paper);
    border-color: var(--line-strong);
}

.theme-light .settings-btn:hover {
    background-color: var(--surface-hover);
    border-color: var(--herb);
    color: var(--herb);
}

.theme-light .settings-btn--danger {
    color: #C1502F;
    border-color: #C1502F;
}

.theme-light .settings-btn--danger:hover {
    background-color: rgba(193, 80, 47, 0.1);
    color: #D96B4A;
    border-color: #D96B4A;
}