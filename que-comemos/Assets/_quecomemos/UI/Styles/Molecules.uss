.day-card-head {
    -unity-text-align: middle-left;
    justify-content: center;
    flex-direction: column;
    width: 72px;
    flex-shrink: 0;
    flex-grow: 0;
    border-right-width: 1px;
    border-right-color: var(--line);
    padding-right: 10px;
    margin-right: 12px;
}

.day-name {
    font-size: 11px;
    letter-spacing: 0.4px;
    color: var(--muted);
}

.day-num {
    font-size: 18px;
    color: var(--paper);
    -unity-font-style: italic;
    margin-top: 1px;
}

.day-card-head--today .day-name {
    color: var(--herb);
}

.meal-slot {
    flex-direction: column;
    margin-bottom: 10px;
    flex-shrink: 0;
    flex-grow: 0;
}

.meal-tag {
    flex-direction: row;
    align-items: center;
    font-size: 10px;
    letter-spacing: 0.4px;
    -unity-font-style: bold;
    color: var(--muted);
    margin-bottom: 5px;
}

.cell-btn {
    width: 100%;
    min-height: 54px;
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 10px;
    background-color: var(--surface-2);
    padding: 8px 9px;
    color: var(--paper);
    -unity-text-align: middle-left;
    flex-direction: column;
    justify-content: center;
    white-space: normal;
    flex-shrink: 0;
    flex-grow: 0;
}

.cell-btn:hover {
    background-color: var(--surface-hover);
    border-color: var(--herb);
}

.cell-btn--selected {
    border-width: 1px;
    border-color: var(--herb);
    background-color: var(--surface-hover);
}

.cell-dish {
    font-size: 13px;
    white-space: normal;
}

.cell-empty {
    font-size: 12px;
    color: var(--muted);
}

.cell-meta {
    font-size: 10px;
    color: var(--muted);
}

.menu-section-label {
    font-size: 11px;
    letter-spacing: 0.4px;
    color: var(--muted);
    padding: 6px 10px 4px;
    flex-shrink: 0;
}

.menu-item {
    width: 100%;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    padding: 10px 11px;
    border-radius: 9px;
    border-width: 0;
    font-size: 14px;
    color: var(--paper);
    flex-shrink: 0;
}

.menu-item:hover {
    background-color: var(--surface-hover);
}

.menu-item--active {
    background-color: rgba(143, 196, 110, 0.16);
    color: var(--herb);
    -unity-font-style: bold;
}

.menu-item--danger {
    color: var(--rust);
}

.menu-item--danger:hover {
    background-color: rgba(226, 115, 90, 0.15);
}

#shared-calendars-container {
    flex-shrink: 0;
}

.calendar-menu-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.calendar-menu-row .menu-item {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;                  
    overflow: hidden;             
    text-overflow: ellipsis;      
    white-space: nowrap;          
    margin-right: 8px;     
}

.leave-menu-btn {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--rust);
    font-size: 16px;
    -unity-text-align: middle-center;
    margin-left: 4px;
    flex-shrink: 0;
    margin-right: 12px;
}

.leave-menu-btn:hover {
    background-color: rgba(226, 115, 90, 0.15);
}

.menu-divider {
    height: 1px;
    background-color: var(--line-strong);
    margin: 7px 4px;
    flex-shrink: 0;
}
.reminder-line {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 16px;
}

.reminder-line > * {
    margin-right: 8px;
    margin-bottom: 4px;
}

.pin-menu-btn {
    width: 28px;
    height: 28px;
    margin-right: 4px;
    background-color: transparent;
    border-width: 0;
    background-size: 18px 18px;
    background-repeat: no-repeat;
    background-position: center;
}