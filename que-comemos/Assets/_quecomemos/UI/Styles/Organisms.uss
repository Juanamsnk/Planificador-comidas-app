.topbar {
    flex-shrink: 0;
    flex-grow: 0;
    width: 100%;
    background-color: var(--surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--line-strong);
    padding: 12px 16px;
}

.header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 10px;
}

.header-actions {
    flex-direction: row;
}

.menu-wrap {
    position: relative;
}

.dropdown-menu {
    position: absolute;
    top: 48px;
    right: 0;
    min-width: 210px;
    background-color: var(--surface);
    border-width: 2px;
    border-color: var(--line-strong);
    border-radius: 14px;
    padding: 10px;
    flex-shrink: 0;
    flex-grow: 0;
    display: none;
}

.week-nav {
    flex-direction: column;
    align-items: flex-start;
    margin: 26px 0 18px;
}

.nav-group {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.week-nav-label {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: auto;
    -unity-text-align: middle-left;
    font-size: 17px;
    color: var(--paper);
    -unity-font-style: italic;
    overflow: hidden;
    white-space: normal;
}

.nav-group > * {
    margin-right: 6px;
}

.week-nav-label__year {
    font-size: 12px;
    color: var(--muted);
    -unity-font-style: normal;
    margin-left: 6px;
}

.nav-spacer {
    width: 80px;
    display: none;
}

.day-card {
    background-color: var(--surface);
    border-width: 2px;
    border-color: var(--line);
    border-radius: 16px;
    padding: 12px;
    flex-direction: row;
    margin-bottom: 10px;
    width: 100%;
    flex-shrink: 0;
    flex-grow: 0;
    transition-property: background-color;
    transition-duration: 0.6s;
    transition-timing-function: ease-in-out;
}

.day-card--highlighted {
    background-color: var(--herb-deep-light);
}

.day-card--today {
    border-color: var(--herb);
    border-width: 2px;
}

.day-meals {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    margin-top: 0;
}

.week-grid {
    flex-direction: column;
    width: 100%;
}

.edit-panel {
    margin-top: 24px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 16px;
    padding: 22px 24px;
}

.edit-panel__title {
    font-size: 19px;
    -unity-font-style: italic;
    color: var(--paper);
    margin-bottom: 16px;
}

.edit-panel__row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 14px;
}

.edit-panel__field {
    flex-direction: column;
    flex-grow: 1;
    min-width: 100%;
}

.edit-panel__btn-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.toast {
    position: absolute;
    bottom: 22px;
    left: 50%;
    translate: -50% 0;
    background-color: var(--paper);
    color: var(--ink);
    padding: 11px 20px;
    border-radius: 10px;
    font-size: 14px;
    -unity-font-style: bold;
    opacity: 0;
    display: none;
    z-index: 1000;
}

.toast--show {
    opacity: 1;
    display: flex;
}
