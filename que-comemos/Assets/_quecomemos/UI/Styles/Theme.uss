
.theme-dark {
    --ink: #14171A;
    --surface: #14171A;
    --surface-2: #242A2E;
    --surface-hover: #2D343A;
    --paper: #F1F0EA;
    --muted: #8D949B;
    --line: rgba(241, 240, 234, 0.08);
    --line-strong: rgba(241, 240, 234, 0.18);
    --herb: #8FC46E;
    --herb-deep: #6FA34E;
    --herb-deep-light: rgba(111, 163, 78, 0.20);
    --herb-ink: #12210D;
    --gold: #E8B24D;
    --plum: #7C93C4;
    --rust: #E2735A;
}

.theme-light {
    --ink: #FFFFFF;
    --surface: #FFFFFF;
    --surface-2: #F1F3EE;
    --surface-hover: #E7EAE1;
    --paper: #20241F;
    --muted: #6B7267;
    --line: rgba(20, 23, 20, 0.08);
    --line-strong: rgba(20, 23, 20, 0.16);
    --herb: #5FA23B;
    --herb-deep: #4A8A2C;
    --herb-deep-light: rgba(111, 163, 78, 0.20);
    --herb-ink: #FFFFFF;
    --gold: #B9791E;
    --plum: #5D6FA0;
    --rust: #C1502F;
}

.theme-switching .day-card {
    transition-property: none;
}
