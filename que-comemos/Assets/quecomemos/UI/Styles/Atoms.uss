/* ==========================================================================
   ATOMS.uss — piezas mínimas reutilizables (botones, inputs, texto, badges)
   Equivalente a: .brand h1, .menu-btn, .nav-btn, .today-btn, .btn(+variants),
   input[type=...], label, .calendar-owner-badge, .demo-badge, .guest-note
   ========================================================================== */

/* ---------- Tipografía base ---------- */
/* Sin fuentes propias importadas todavía: se usa la fuente por defecto de
   Unity (la que trae el USS por defecto del proyecto). Cuando importes
   "Newsreader" y "Manrope" como Font Asset, añade aquí la línea:
     -unity-font-definition: url("project://database/Assets/.../TuFuente SDF.asset");
   dentro de .text-body (Manrope) y .text-heading / .brand-title (Newsreader). */
.text-body {
    font-size: 14px;
    color: var(--paper);
}

.text-heading {
    -unity-font-style: italic;
    color: var(--paper);
    -unity-text-align: middle-left;
}

.brand-title {
    font-size: 30px;
    color: var(--paper);
    -unity-font-style: italic;
    letter-spacing: -0.3px;
}

/* ---------- Botones circular/cuadrados de icono (menú, tema) ---------- */
.icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line-strong);
    color: var(--paper);
    font-size: 17px;
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
}

.icon-btn:hover {
    background-color: var(--surface-hover);
}

/* ---------- Botones de navegación de semana ---------- */
.nav-btn {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line-strong);
    color: var(--paper);
    font-size: 16px;
    -unity-text-align: middle-center;
}

.nav-btn:hover {
    background-color: var(--surface-hover);
}

.today-btn {
    font-size: 12px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 10px;
    padding-left: 8px;
    padding-right: 8px;
    height: 34px;
    color: var(--paper);
    -unity-text-align: middle-center;
}

.today-btn:hover {
    background-color: var(--surface-hover);
}

/* ---------- Botones genéricos (.btn / .btn.primary / .btn.ghost / .btn.danger) ---------- */
.btn {
    font-size: 13px;
    -unity-font-style: bold;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 13px;
    padding-right: 13px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--line-strong);
    background-color: var(--surface-2);
    color: var(--paper);
    -unity-text-align: middle-center;
    margin-right: 8px;
    margin-bottom: 8px;
}

.btn:hover {
    background-color: var(--surface-hover);
}

.btn--primary {
    background-color: var(--herb);
    color: var(--herb-ink);
    border-color: var(--herb);
}

.btn--primary:hover {
    background-color: var(--herb-deep);
}

.btn--danger {
    color: var(--rust);
    border-color: var(--rust);
}

.btn--danger:hover {
    background-color: rgba(226, 115, 90, 0.15);
}

.btn--ghost {
    background-color: rgba(0, 0, 0, 0);
}

/* ---------- Campos de texto (input[type=text/password/date/time]) ---------- */
.input-field {
    font-size: 15px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 10px;
    background-color: var(--ink);
    color: var(--paper);
}

.input-field--compact {
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 9px;
    padding-right: 9px;
    font-size: 13px;
}

/* ---------- Etiqueta de campo ---------- */
.field-label {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 6px;
}

/* ---------- Punto de color para "Comida" / "Cena" ---------- */
.meal-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    margin-right: 5px;
}

.meal-dot--comida {
    background-color: var(--gold);
}

.meal-dot--cena {
    background-color: var(--plum);
}

/* ---------- Badges (owner / demo / guest) ---------- */
.badge {
    font-size: 12px;
    -unity-font-style: bold;
    border-radius: 100px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 13px;
    padding-right: 13px;
    -unity-text-align: middle-left;
}

.badge--owner {
    color: var(--herb);
    background-color: rgba(143, 196, 110, 0.12);
    border-width: 1px;
    border-color: rgba(143, 196, 110, 0.35);
}

.badge--shared {
    color: var(--plum);
    background-color: rgba(124, 147, 196, 0.14);
    border-width: 1px;
    border-color: rgba(124, 147, 196, 0.4);
}

.badge--demo {
    color: var(--gold);
    background-color: rgba(232, 178, 77, 0.14);
    border-width: 1px;
    border-color: rgba(232, 178, 77, 0.4);
}

.guest-note {
    font-size: 12px;
    color: var(--muted);
}
